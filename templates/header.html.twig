<header>
	<div class="admin-buttons">
		{% if app.user %}
			<a type="button" class="btn d-inline-flex align-items-center" href="{{ path('app_account') }}" aria-label="Mon compte">
				<span class="d-none d-lg-inline">Mon compte</span>
				<span class="header-button-icon" aria-hidden="true">
					<span class="svg-container">
						<svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" class="svg-content bi bi-person-circle" viewBox="0 0 16 16">
							<path d="M11 6a3 3 0 1 1-6 0 3 3 0 0 1 6 0"/>
							<path fill-rule="evenodd" d="M0 8a8 8 0 1 1 16 0A8 8 0 0 1 0 8m8-7a7 7 0 0 0-5.468 11.37C3.242 11.226 4.805 10 8 10s4.757 1.225 5.468 2.37A7 7 0 0 0 8 1"/>
						</svg>
					</span>
				</span>
			</a>
			{% if "ROLE_ADMIN" in app.user.roles %}
				<a type="button" class="btn d-inline-flex align-items-center" href="/admin" aria-label="Administration">
					<span class="d-none d-lg-inline">Admin</span>
					<span class="header-button-icon" aria-hidden="true">
						<span class="svg-container">
							<svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" class="svg-content bi bi-gear-fill" viewBox="0 0 16 16">
								<path d="M9.405 1.05c-.413-1.4-2.397-1.4-2.81 0l-.1.34a1.45 1.45 0 0 1-2.12.895l-.305-.175c-1.257-.72-2.66.683-1.94 1.94l.175.305a1.45 1.45 0 0 1-.895 2.12l-.34.1c-1.4.413-1.4 2.397 0 2.81l.34.1a1.45 1.45 0 0 1 .895 2.12l-.175.305c-.72 1.257.683 2.66 1.94 1.94l.305-.175a1.45 1.45 0 0 1 2.12.895l.1.34c.413 1.4 2.397 1.4 2.81 0l.1-.34a1.45 1.45 0 0 1 2.12-.895l.305.175c1.257.72 2.66-.683 1.94-1.94l-.175-.305a1.45 1.45 0 0 1 .895-2.12l.34-.1c1.4-.413 1.4-2.397 0-2.81l-.34-.1a1.45 1.45 0 0 1-.895-2.12l.175-.305c.72-1.257-.683-2.66-1.94-1.94l-.305.175a1.45 1.45 0 0 1-2.12-.895zM8 10.5a2.5 2.5 0 1 1 0-5 2.5 2.5 0 0 1 0 5"/>
							</svg>
						</span>
					</span>
				</a>
			{% endif %}
		{% endif %}
		{% if not app.user %}
			<a type="button" class="btn d-inline-flex align-items-center" href="/register">
				<span class="d-none d-lg-inline">Créer un compte</span>
				<span class="header-button-icon">
					<span class="svg-container">
						<svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" class="svg-content bi bi-person-plus-fill" viewbox="0 0 16 16">
							<path d="M1 14s-1 0-1-1 1-4 6-4 6 3 6 4-1 1-1 1H1zm5-6a3 3 0 1 0 0-6 3 3 0 0 0 0 6z"/>
							<path fill-rule="evenodd" d="M13.5 5a.5.5 0 0 1 .5.5V7h1.5a.5.5 0 0 1 0 1H14v1.5a.5.5 0 0 1-1 0V8h-1.5a.5.5 0 0 1 0-1H13V5.5a.5.5 0 0 1 .5-.5z"/>
						</svg>
					</span>
				</span>
			</a>
		{% endif %}
		<a type="button" class="btn d-inline-flex align-items-center" href="{{ app.user ? path('logout') : path('login', { 'to':app.request.attributes.get('_route') }) }}">
			<span class="d-none d-lg-inline">{{ app.user ? 'Déconnexion' : 'Connexion' }}</span>
			<span class="header-button-icon">
				<span class="svg-container">
					{{ app.user ? 
          '<svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" class="svg-content bi bi-person-x-fill" viewBox="0 0 16 16">
            <path fill-rule="evenodd" d="M1 14s-1 0-1-1 1-4 6-4 6 3 6 4-1 1-1 1H1zm5-6a3 3 0 1 0 0-6 3 3 0 0 0 0 6zm6.146-2.854a.5.5 0 0 1 .708 0L14 6.293l1.146-1.147a.5.5 0 0 1 .708.708L14.707 7l1.147 1.146a.5.5 0 0 1-.708.708L14 7.707l-1.146 1.147a.5.5 0 0 1-.708-.708L13.293 7l-1.147-1.146a.5.5 0 0 1 0-.708z"/>
          </svg>' 
          :
          '<svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" class="svg-content bi bi-person-check-fill" viewBox="0 0 16 16">
            <path fill-rule="evenodd" d="M15.854 5.146a.5.5 0 0 1 0 .708l-3 3a.5.5 0 0 1-.708 0l-1.5-1.5a.5.5 0 0 1 .708-.708L12.5 7.793l2.646-2.647a.5.5 0 0 1 .708 0z"/>
            <path d="M1 14s-1 0-1-1 1-4 6-4 6 3 6 4-1 1-1 1H1zm5-6a3 3 0 1 0 0-6 3 3 0 0 0 0 6z"/>
          </svg>'
        }}
				</span>
			</span>
		</a>
	</div>
	<nav class="navbar navbar-expand-lg navbar-dark">
		<div class="container-fluid">
			<a class="navbar-brand" href="{{ path('app_accueil') }}">
				<img class="logo" src="{{ asset('images/logo.PNG') }}" alt="Logo Grand Cinéma"/>
				<h1 class="title d-none">Grand Cinéma</h1>
			</a>

			<button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarScroll" aria-controls="navbarScroll" aria-expanded="false" aria-label="Toggle navigation">
				<span class="navbar-toggler-icon  btn d-inline-flex"></span>
			</button>
			<div class="collapse navbar-collapse" id="navbarScroll">
				<ul class="navbar-nav my-2 p-3 mt-lg-5 navbar-nav-scroll">
					<li class="nav-item ms-2">
						<a class="nav-link {% if app.request.attributes.get('_route') ==  'app_accueil' or app.request.get('routeName') ==  'app_accueil' %}active{% endif %} ms-5" aria-current="page" id="/hotel/" href="{{ path('app_accueil') }}">Accueil
						</a>
					</li>
					{% if not app.user %}
						<li class="nav-item ms-2">
							<a class="nav-link ">Nos&nbsp;Séances</a>
						</li>
					{% endif %}
					{% if app.user and "ROLE_CLIENT" in app.user.roles  %}
					{% endif %}
					{% if app.user %}
						{% if  "ROLE_ADMIN" in app.user.roles %}

						{% elseif "ROLE_USER" in app.user.roles %}

						{% endif %}
					{% endif %}

				</ul>
			</div>
		</div>
	</nav>
	<div class="fond-gris centre announcement">
		<div>
			{% if app.user %}
				{{ app.user ? app.user.email : '' }}
				Bienvenue  sur Grand Cinéma !
			{% else %}
				Bienvenue sur Grand Cinéma !
			{% endif %}
		</div>
	</div>
</header>
