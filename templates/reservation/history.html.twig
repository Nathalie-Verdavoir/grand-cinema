{% extends 'base.html.twig' %}

{% block title %}Mes réservations - Grand Cinéma{% endblock %}

{% block body %}
    <div class="container home-page cart-page">
        <section class="cart-panel" aria-labelledby="reservations-title">
            <h1 id="reservations-title">Mes réservations</h1>
            <p class="cart-introduction">Retrouvez vos réservations et accédez aux billets de vos séances payées.</p>

            <div class="cart-reservations">
                {% for reservation in reservations %}
                    <article class="cart-reservation">
                        <div class="cart-reservation-heading">
                            <div>
                                <h2>{{ reservation.seance.film.title }}</h2>
                                <p>{{ reservation.seance.dateTime|date('d/m/Y à H:i') }} · {{ reservation.seance.salle.name }}</p>
                            </div>
                            <span class="cart-reservation-status">{{ reservation.status.label }}</span>
                        </div>
                        <div class="cart-reservation-footer">
                            <p>
                                {{ reservation.nbPlaces }} place{{ reservation.nbPlaces > 1 ? 's' : '' }}
                                · Réservée le {{ reservation.reservedAt|date('d/m/Y') }}
                                · Total : <strong>{{ reservation.totalPrice|number_format(2, ',', ' ') }} €</strong>
                            </p>
                            <div class="cart-reservation-actions">
                                {% if reservation.status.value == 'paid' %}
                                    <a class="cart-reservation-action cart-reservation-payment" href="{{ path('app_reservation_tickets', {reference: reservation.reference}) }}">
                                        Voir mes billets
                                    </a>
                                    <form action="{{ path('app_reservation_send_invoice', {reference: reservation.reference}) }}" method="post">
                                        <input type="hidden" name="_token" value="{{ csrf_token('send-invoice-' ~ reservation.reference) }}">
                                        <button class="cart-reservation-action cart-reservation-payment" type="submit">
                                            Obtenir la facture
                                        </button>
                                    </form>
                                    <a class="cart-reservation-action cart-reservation-payment" href="{{ path('app_reservation_tickets', {reference: reservation.reference}) }}?download=all">
                                        Télécharger les billets (PDF)
                                    </a>
                                    {% if reservation.canBeCancelledAfterPayment %}
                                        <button class="cart-reservation-action cart-reservation-cancel" type="button" data-bs-toggle="modal" data-bs-target="#paid-cancel-reservation-{{ reservation.reference }}">
                                            Annuler et être remboursé
                                        </button>
                                    {% endif %}
                                {% elseif reservation.status.value == 'pending' %}
                                    <a class="cart-reservation-action cart-reservation-payment" href="{{ path('app_reservation_paiement', {reference: reservation.reference}) }}">
                                        Reprendre le paiement
                                    </a>
                                {% endif %}
                            </div>
                        </div>
                        {% if reservation.status.value == 'paid' and reservation.canBeCancelledAfterPayment %}
                            <p class="cart-introduction cart-reservation-cancellation-note">Annulation possible jusqu’au {{ reservation.cancellationDeadline|date('d/m/Y à H:i') }}.</p>
                            {% include 'cart/_cancel_reservation_modal.html.twig' with {reservation: reservation, paid: true} only %}
                        {% endif %}
                    </article>
                {% else %}
                    <p class="cart-empty">Vous n’avez encore aucune réservation.</p>
                {% endfor %}
            </div>
        </section>
    </div>
{% endblock %}
