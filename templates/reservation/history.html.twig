{% extends 'base.html.twig' %}

{% block title %}Mes réservations - Grand Cinéma{% endblock %}

{% block body %}
    <div class="container home-page cart-page">
        <section class="cart-panel" aria-labelledby="reservations-title">
            <h1 id="reservations-title">Mes réservations</h1>
            <p class="cart-introduction">Retrouvez vos réservations et accédez aux billets de vos séances payées.</p>

            <div class="cart-reservations">
                {% for reservation in reservations %}
                    <article class="cart-reservation">
                        <div class="cart-reservation-heading">
                            <div>
                                <h2>{{ reservation.seance.film.title }}</h2>
                                <p>{{ reservation.seance.dateTime|date('d/m/Y à H:i') }} · {{ reservation.seance.salle.name }}</p>
                            </div>
                            <span class="cart-reservation-status">{{ reservation.status.label }}</span>
                        </div>
                        <div class="cart-reservation-footer">
                            <p>
                                {{ reservation.nbPlaces }} place{{ reservation.nbPlaces > 1 ? 's' : '' }}
                                · Réservée le {{ reservation.reservedAt|date('d/m/Y') }}
                                · Total : <strong>{{ reservation.totalPrice|number_format(2, ',', ' ') }} €</strong>
                            </p>
                            <div class="cart-reservation-actions">
                                {% if reservation.status.value in ['paid', 'paid_at_counter'] %}
                                    <a class="cart-reservation-action cart-reservation-payment" href="{{ path('app_reservation_tickets', {reference: reservation.reference}) }}">
                                        Voir mes billets
                                    </a>
                                    <a class="cart-reservation-action cart-reservation-payment" href="{{ path('app_reservation_tickets', {reference: reservation.reference}) }}?download=all">
                                        Télécharger les billets (PDF)
                                    </a>
                                {% endif %}
                                {% if reservation.status.value == 'paid' %}
                                    <form action="{{ path('app_reservation_send_invoice', {reference: reservation.reference}) }}" method="post">
                                        <input type="hidden" name="_token" value="{{ csrf_token('send-invoice-' ~ reservation.reference) }}">
                                        <button class="cart-reservation-action cart-reservation-payment" type="submit">
                                            Obtenir la facture
                                        </button>
                                    </form>
                                    {% if reservation.canBeCancelledAfterPayment %}
                                        <button
                                            class="cart-reservation-action cart-reservation-cancel"
                                            type="button"
                                            data-bs-toggle="modal"
                                            data-bs-target="#paid-cancel-reservation-modal"
                                            data-reservation-title="{{ reservation.seance.film.title }}"
                                            data-cancel-url="{{ path('app_reservation_cancel_paid', {reference: reservation.reference}) }}"
                                            data-csrf-token="{{ csrf_token('cancel-paid-reservation-' ~ reservation.reference) }}"
                                        >
                                            Annuler et être remboursé
                                        </button>
                                    {% endif %}
                                {% elseif reservation.status.value == 'pending' %}
                                    <a class="cart-reservation-action cart-reservation-payment" href="{{ path('app_reservation_paiement', {reference: reservation.reference}) }}">
                                        Reprendre le paiement
                                    </a>
                                {% endif %}
                            </div>
                        </div>
                        {% if reservation.status.value == 'paid' and reservation.canBeCancelledAfterPayment %}
                            <p class="cart-introduction cart-reservation-cancellation-note">Annulation possible jusqu’au {{ reservation.cancellationDeadline|date('d/m/Y à H:i') }}.</p>
                        {% endif %}
                    </article>
                {% else %}
                    <p class="cart-empty">Vous n’avez encore aucune réservation.</p>
                {% endfor %}
            </div>

            {% if totalPages > 1 %}
                <nav class="reservation-pagination" aria-label="Pagination des réservations">
                    <ul class="pagination">
                        {% if page > 1 %}
                            <li class="page-item">
                                <a class="page-link" href="{{ path('app_reservation_history', {page: page - 1}) }}" rel="prev">Précédent</a>
                            </li>
                        {% else %}
                            <li class="page-item disabled"><span class="page-link">Précédent</span></li>
                        {% endif %}
                        <li class="page-item disabled"><span class="page-link" aria-current="page">Page {{ page }} sur {{ totalPages }}</span></li>
                        {% if page < totalPages %}
                            <li class="page-item">
                                <a class="page-link" href="{{ path('app_reservation_history', {page: page + 1}) }}" rel="next">Suivant</a>
                            </li>
                        {% else %}
                            <li class="page-item disabled"><span class="page-link">Suivant</span></li>
                        {% endif %}
                    </ul>
                </nav>
            {% endif %}
        </section>
    </div>

    <div class="modal fade" id="paid-cancel-reservation-modal" tabindex="-1" aria-labelledby="paid-cancel-reservation-title" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h2 class="modal-title fs-5" id="paid-cancel-reservation-title">Annuler et rembourser cette réservation ?</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
                </div>
                <div class="modal-body">
                    Voulez-vous vraiment annuler votre réservation pour <strong data-cancel-reservation-film></strong> ?
                    Le remboursement sera demandé et les places seront libérées.
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Conserver ma réservation</button>
                    <form method="post" data-cancel-reservation-form>
                        <input type="hidden" name="_token" value="" data-cancel-reservation-token>
                        <button type="submit" class="btn btn-danger">Confirmer l’annulation et le remboursement</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
