{% extends 'base.html.twig' %}

{% block title %}Accueil et séances - Grand Cinéma{% endblock %}

{% block body %}
    <div class="container discovery-page">
        <div class="discovery-layout">
            <aside class="discovery-featured" aria-label="Films à l'affiche">
                <p class="discovery-eyebrow">Grand Cinéma</p>
                <h1>À l'affiche</h1>
                {% if featuredFilms is not empty %}
                    <div class="discovery-carousel" data-home-carousel role="region" aria-roledescription="carrousel" aria-label="Films à l'affiche">
                        {% if featuredFilms|length > 1 %}
                            <div class="discovery-carousel-indicators">
                                {% for film in featuredFilms %}
                                    <button type="button" data-home-slide-to="{{ loop.index0 }}" class="{{ loop.first ? 'active' : '' }}" {% if loop.first %}aria-current="true"{% endif %} aria-label="Afficher {{ film.title }}"></button>
                                {% endfor %}
                            </div>
                        {% endif %}

                        <div class="discovery-carousel-slides">
                            {% for film in featuredFilms %}
                                <article class="carousel-item {{ loop.first ? 'active' : '' }}" aria-roledescription="diapositive" aria-label="{{ loop.index }} sur {{ featuredFilms|length }}" aria-hidden="{{ loop.first ? 'false' : 'true' }}">
                                    <div class="featured-film-slide">
                                        {% if film.img %}
                                            <img class="featured-film-poster" src="{{ film.img }}" alt="Affiche du film {{ film.title }}" {% if not loop.first %}loading="lazy"{% endif %}>
                                        {% else %}
                                            <div class="featured-film-poster featured-film-poster-placeholder" role="img" aria-label="Affiche indisponible pour {{ film.title }}">{{ film.title }}</div>
                                        {% endif %}
                                        <div class="featured-film-copy">
                                            <p class="featured-film-label">À découvrir</p>
                                            <h2>{{ film.title }}</h2>
                                            {% if film.duration %}
                                                <p class="featured-film-duration">{{ '%02d'|format(film.duration // 60) }}h{{ '%02d'|format(film.duration % 60) }}</p>
                                            {% endif %}
                                            {% if film.description %}
                                                <p class="featured-film-description">{{ film.description }}</p>
                                            {% endif %}
                                            <a class="featured-film-link" href="{{ path('app_programmation_film', {id: film.id}) }}">Découvrir le film</a>
                                        </div>
                                    </div>
                                </article>
                            {% endfor %}
                        </div>

                        <nav class="discovery-carousel-controls" aria-label="Navigation des films à l'affiche">
                            <button class="discovery-carousel-button" type="button" data-carousel-direction="-1" aria-label="Film précédent" {% if featuredFilms|length < 2 %}disabled{% endif %}>
                                <svg aria-hidden="true" viewBox="0 0 24 24" focusable="false"><path d="M19 12H5m0 0 7 7m-7-7 7-7"/></svg>
                            </button>
                            {% if featuredFilms|length > 1 %}
                                <button class="discovery-carousel-toggle" type="button" data-carousel-toggle aria-label="Mettre en pause le défilement" title="Mettre en pause le défilement" aria-pressed="false">
                                    <svg data-carousel-pause-icon aria-hidden="true" viewBox="0 0 24 24" focusable="false"><path d="M9 5v14m6-14v14"/></svg>
                                    <svg data-carousel-play-icon aria-hidden="true" viewBox="0 0 24 24" focusable="false" hidden><path d="m8 5 12 7-12 7z"/></svg>
                                </button>
                            {% endif %}
                            <button class="discovery-carousel-button" type="button" data-carousel-direction="1" aria-label="Film suivant" {% if featuredFilms|length < 2 %}disabled{% endif %}>
                                <svg aria-hidden="true" viewBox="0 0 24 24" focusable="false"><path d="M5 12h14m0 0-7-7m7 7-7 7"/></svg>
                            </button>
                        </nav>
                    </div>
                {% else %}
                    <p class="discovery-featured-empty">Aucun film n'est actuellement programmé. Revenez bientôt découvrir notre prochaine sélection.</p>
                {% endif %}
            </aside>

            <section class="discovery-screenings" id="seances" aria-labelledby="screenings-title" data-programming-week aria-busy="false">
                <div class="discovery-screenings-content" data-programming-week-content>
                    {% include 'programmation/_screenings.html.twig' %}
                </div>
                <p class="visually-hidden" data-programming-week-status role="status" aria-live="polite"></p>
                <p class="alert alert-danger mt-3 d-none" data-programming-week-error role="alert"></p>
            </section>
        </div>
    </div>
{% endblock %}
