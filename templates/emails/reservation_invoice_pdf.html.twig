<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <style>
        body { font-family: DejaVu Sans, sans-serif; color: #20242a; font-size: 12px; }
        h1 { margin-bottom: 4px; font-size: 26px; }
        .muted { color: #606a75; }
        .details { margin: 28px 0; }
        table { width: 100%; border-collapse: collapse; }
        th, td { padding: 10px 8px; border-bottom: 1px solid #d9dee4; text-align: left; }
        th:last-child, td:last-child { text-align: right; }
        .total { margin-top: 22px; text-align: right; font-size: 16px; font-weight: bold; }
        .paid { margin-top: 28px; color: #247044; font-weight: bold; }
    </style>
</head>
<body>
    <h1>Facture</h1>
    <p class="muted">Grand Cinéma · Émise le {{ issuedAt|date('d/m/Y') }}</p>

    <div class="details">
        <strong>Facture n° {{ reservation.reference }}</strong><br>
        Client : {{ reservation.user.email }}<br>
        Film : {{ reservation.seance.film.title }}<br>
        Séance : {{ reservation.seance.dateTime|date('d/m/Y à H:i') }} — {{ reservation.seance.salle.name }}
    </div>

    <table>
        <thead>
            <tr>
                <th>Prestation</th>
                <th>Montant</th>
            </tr>
        </thead>
        <tbody>
            {% for line in lines %}
                <tr>
                    <td>{{ line.description }}</td>
                    <td>{{ line.price|number_format(2, ',', ' ') }} €</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>

    <p class="total">Total payé : {{ reservation.totalPrice|number_format(2, ',', ' ') }} €</p>
    <p class="paid">Payée</p>
</body>
</html>
