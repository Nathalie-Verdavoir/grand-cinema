<div class="seance-planner-toolbar {{ isDailyView ? 'is-daily' : 'is-weekly' }}">
    {% if not isDailyView %}
        <form method="get" action="{{ path('admin_seance_index') }}" class="seance-room-selector">
            <label for="schedule-room">Salle</label>
            <input type="hidden" name="week" value="{{ weekStart|date('Y-m-d') }}">
            <select id="schedule-room" name="salle" class="form-select" {% if rooms is empty %}disabled{% endif %} onchange="this.form.submit()">
                {% for room in rooms %}
                    <option value="{{ room.id }}" {% if selectedRoom and room.id == selectedRoom.id %}selected{% endif %}>{{ room.name }}</option>
                {% endfor %}
            </select>
        </form>
    {% endif %}

    <form method="post" action="{{ path(isDailyView ? 'admin_seance_generate_day' : 'admin_seance_generate_week') }}" class="seance-generate-form">
        <input type="hidden" name="_token" value="{{ csrf_token(isDailyView ? 'admin_generate_day' : 'admin_generate_week') }}">
        <input type="hidden" name="{{ isDailyView ? 'day' : 'week' }}" value="{{ (isDailyView ? selectedDate : weekStart)|date('Y-m-d') }}">
        <input type="hidden" name="salle" value="{{ selectedRoom ? selectedRoom.id : '' }}">
        <button type="submit" class="btn btn-primary" {% if not hasProgrammableFilms or rooms is empty %}disabled{% endif %}>
            {{ isDailyView ? 'Générer le brouillon du jour' : 'Générer le brouillon de la semaine' }}
        </button>
    </form>

    {% if isDailyView %}
        <form method="post" action="{{ path('admin_seance_publish_day') }}" class="seance-publish-day-form">
            <input type="hidden" name="_token" value="{{ csrf_token('admin_publish_day') }}">
            <input type="hidden" name="day" value="{{ selectedDate|date('Y-m-d') }}">
            <input type="hidden" name="salle" value="{{ selectedRoom ? selectedRoom.id : '' }}">
            <button type="submit" class="btn btn-success">Publier les brouillons du jour</button>
        </form>
    {% elseif selectedRoom %}
        <form method="post" action="{{ path('admin_seance_publish_week') }}" class="seance-publish-week-form">
            <input type="hidden" name="_token" value="{{ csrf_token('admin_publish_week') }}">
            <input type="hidden" name="week" value="{{ weekStart|date('Y-m-d') }}">
            <input type="hidden" name="salle" value="{{ selectedRoom.id }}">
            <button type="submit" class="btn btn-success">Publier les brouillons de la semaine</button>
        </form>
    {% endif %}

    <nav class="seance-week-navigation" aria-label="Navigation entre les semaines">
        {% if isDailyView %}
            <a class="btn btn-secondary" href="{{ ea_url().setController('App\\Controller\\Admin\\SeanceCrudController').setAction('index').set('view', 'day').set('day', previousDay).set('salle', selectedRoom ? selectedRoom.id : '') }}" aria-label="Jour précédent"><span class="seance-navigation-arrow" aria-hidden="true">&lsaquo;</span></a>
            <strong>{{ selectedDate|date('d/m/Y') }}{% if isToday %} <span class="badge badge-success">Aujourd’hui</span>{% endif %}</strong>
            <a class="btn btn-secondary" href="{{ ea_url().setController('App\\Controller\\Admin\\SeanceCrudController').setAction('index').set('view', 'day').set('day', nextDay).set('salle', selectedRoom ? selectedRoom.id : '') }}" aria-label="Jour suivant"><span class="seance-navigation-arrow" aria-hidden="true">&rsaquo;</span></a>
            {% if not isToday %}<a class="btn btn-link" href="{{ ea_url().setController('App\\Controller\\Admin\\SeanceCrudController').setAction('index').set('view', 'day').set('day', 'now'|date('Y-m-d')).set('salle', selectedRoom ? selectedRoom.id : '') }}">Aujourd’hui</a>{% endif %}
        {% else %}
            <a class="btn btn-secondary" href="{{ ea_url().setController('App\\Controller\\Admin\\SeanceCrudController').setAction('index').set('week', previousWeek).set('salle', selectedRoom ? selectedRoom.id : '') }}" aria-label="Semaine précédente" title="Semaine précédente"><span class="seance-navigation-arrow" aria-hidden="true">&lsaquo;</span></a>
            <strong>
                {{ weekStart|date('d/m/Y') }} – {{ weekEnd|date('d/m/Y') }}
                {% if isCurrentWeek %}<span class="badge badge-success">Cette semaine</span>{% endif %}
            </strong>
            <a class="btn btn-secondary" href="{{ ea_url().setController('App\\Controller\\Admin\\SeanceCrudController').setAction('index').set('week', nextWeek).set('salle', selectedRoom ? selectedRoom.id : '') }}" aria-label="Semaine suivante" title="Semaine suivante"><span class="seance-navigation-arrow" aria-hidden="true">&rsaquo;</span></a>
            {% if not isCurrentWeek %}
                <a class="btn btn-link" href="{{ ea_url().setController('App\\Controller\\Admin\\SeanceCrudController').setAction('index').set('salle', selectedRoom ? selectedRoom.id : '') }}">Aujourd’hui</a>
            {% endif %}
        {% endif %}
    </nav>

</div>
