<article class="cart-reservation">
    <div class="cart-reservation-heading">
        <div>
            <h2>{{ reservation.seance.film.title }}</h2>
            <p>{{ reservation.seance.dateTime|date('d/m/Y à H:i') }} · {{ reservation.seance.salle.name }}</p>
        </div>
        <span class="cart-reservation-status">{{ reservation.status.label }}</span>
    </div>
    <p class="reservation-countdown" data-reservation-countdown data-expiration-timestamp="{{ reservation_expiration_timestamp(reservation) * 1000 }}">
        Temps restant avant expiration : <time>Calcul en cours…</time>
    </p>
    <ul class="cart-reservation-tickets">
        {% for ticketGroup in reservation_ticket_summary(reservation) %}
            <li>
                {{ ticketGroup.tarif }} — {{ ticketGroup.quantity }}
                × {{ ticketGroup.unitPrice|number_format(2, ',', ' ') }} €
                = {{ ticketGroup.subtotal|number_format(2, ',', ' ') }} €
            </li>
        {% endfor %}
    </ul>
    <div class="cart-reservation-footer">
        <p>
            {{ reservation.nbPlaces }} place{{ reservation.nbPlaces > 1 ? 's' : '' }}
            · Total : <strong>{{ reservation.totalPrice|number_format(2, ',', ' ') }} €</strong>
        </p>
        <div class="cart-reservation-actions">
            <button class="cart-reservation-action cart-reservation-cancel" type="button" data-bs-toggle="modal" data-bs-target="#cancel-reservation-{{ reservation.reference }}">
                Annuler
            </button>
            <a class="cart-reservation-action cart-reservation-payment" href="{{ path('app_reservation_paiement', {reference: reservation.reference}) }}">
                Payer
            </a>
        </div>
    </div>
    {% include 'cart/_cancel_reservation_modal.html.twig' with {reservation: reservation} only %}
</article>
