{% extends 'base.html.twig' %}

{% block title %}Mon panier - Grand Cinéma{% endblock %}

{% block body %}
    <div class="container home-page cart-page">
        <section class="cart-panel" aria-labelledby="cart-title">
            <h1 id="cart-title">Mon panier</h1>
            <p class="cart-introduction">Retrouvez vos réservations en attente et reprenez le paiement quand vous le souhaitez.</p>

            <div class="cart-reservations">
                {% for reservation in pendingReservations %}
                    <article class="cart-reservation">
                        <div class="cart-reservation-heading">
                            <div>
                                <h2>{{ reservation.seance.film.title }}</h2>
                                <p>{{ reservation.seance.dateTime|date('d/m/Y à H:i') }} · {{ reservation.seance.salle.name }}</p>
                            </div>
                            <span class="cart-reservation-status">En attente de paiement</span>
                        </div>
                        <ul class="cart-reservation-tickets">
                            {% for billet in reservation.billets %}
                                <li>{{ billet.tarif.name }} — {{ billet.priceApplied|number_format(2, ',', ' ') }} €</li>
                            {% endfor %}
                        </ul>
                        <div class="cart-reservation-footer">
                            <p>
                                {{ reservation.nbPlaces }} place{{ reservation.nbPlaces > 1 ? 's' : '' }}
                                · Total : <strong>{{ reservation.totalPrice|number_format(2, ',', ' ') }} €</strong>
                            </p>
                            <a class="cart-reservation-payment" href="{{ path('app_reservation_paiement', {reference: reservation.reference}) }}">
                                Payer
                            </a>
                        </div>
                    </article>
                {% else %}
                    <p class="cart-empty">Votre panier ne contient aucune réservation en attente.</p>
                {% endfor %}
            </div>
        </section>
    </div>
{% endblock %}
